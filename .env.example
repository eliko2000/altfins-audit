# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Username or invite link of the AltFINS free channel.
# Examples: "altfins_io", "altfinscrypto" — adjust to whichever public one you joined.
ALTFINS_CHANNEL=altfinsofficialchat

# How far back to scrape on first run (days)
SCRAPE_DAYS=180

# Evaluation settings
FILL_WINDOW_HOURS=24       # signal "unfilled" if price never trades into entry zone within this window
HORIZON_DAYS=14            # max time to wait for SL or final TP
FEE_BPS=10                 # round-trip fee assumption per leg, in basis points (10 = 0.10%)
EXCHANGE=binance           # Binance USDT pairs only in v1
